// C++ code
// Traffic Lights Controller
int LED_R=13;
int LED_Y=12;
int LED_G=11;

void setup()
{
  pinMode(LED_BUILTIN, OUTPUT);
}

void loop()
{
  digitalWrite(LED_R, HIGH);
  delay(1000); 
  digitalWrite(LED_R, LOW);
  delay(1000); 
  digitalWrite(LED_Y, HIGH);
  delay(1000); 
  digitalWrite(LED_Y, LOW);
  delay(1000); 
  digitalWrite(LED_G, HIGH);
  delay(1000); 
  digitalWrite(LED_G, LOW);
  delay(1000); 
}
