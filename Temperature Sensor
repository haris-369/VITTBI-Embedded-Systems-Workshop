// C++ code
// Temperature Sensor with LCD Display
#include <LiquidCrystal.h>

// Initialize the library with the numbers of the interface pins
LiquidCrystal lcd(8, 7, 6, 5, 4, 3);

int sensorPin = 0;

void setup()
{
  Serial.begin(9600);
  lcd.begin(16, 2);
}

void loop()
{
  int reading = analogRead(sensorPin);

  // measure the 5v with a meter for an accurate value
  // In particular if your Arduino is USB powered
  float voltage = reading * 5.0; // Changed from 4.68 to 5.0 for Tinkercad accuracy
  voltage /= 1024.0;

  // now print out the temperature
  float temperatureC = (voltage - 0.5) * 100;
  
  Serial.print(temperatureC);
  Serial.println(" degrees C");

  // Print to the LCD display
  lcd.setCursor(0, 0);
  lcd.print("Temperature Value ");
  
  lcd.setCursor(0, 1);
  lcd.print(temperatureC);
  lcd.print(" degrees C  "); // Added trailing spaces to clear overlapping characters

  delay(100);
}
